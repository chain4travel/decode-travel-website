---
import { Icon } from 'astro-icon/components'

import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSimple from "../components/HeroSimple.astro";
import ChallengeLinks from '../components/ChallengeLinks.astro';

import { Image } from 'astro:assets';
import BugBountyImage from '../images/bug-bounty-chip.png'
import MessengerLogo from '../images/camino-messenger-logo.png'
import MtsLogo from '../images/mts-logo.png'
import A3mLogo from '../images/a3m-logo.png'
---

<BaseLayout>

  <HeroSimple />

  <section class="pb-8 md:pb-16 border-b border-gray-800 bg-gradient-hackerz-b">
    <div class="max-w-screen-lg px-4 mx-auto">
        <div class="lg:grid grid-cols-2 gap-4 xl:gap-6 2xl:gap-8 mt-8 relative">
            
            <div class="bg-gradient-primary bg-gray-900 rounded-xl p-4 md:p-8 mb-4 md:mb-0">
              <div class="text-white font-bold text-2xl uppercase tracking-tight">Before you start</div>
              <div class="flex flex-col gap-3 mt-6">
                <div class="flex items-center gap-2">
                  <Icon name="tabler:wallet" class="w-6 h-6 shrink-0" />
                  Wallet:
                  <a class="underline" href="https://suite.camino.network/wallet/home" target="_blank" rel="noopener noreferrer">Camino Suite</a>
                </div>
                <div class="flex items-center gap-2">
                  <Icon name="tabler:brand-discord" class="w-6 h-6 shrink-0" />
                  Communication:
                  <a class="underline" href="https://discord.gg/camino" target="_blank" rel="noopener noreferrer">Decode Travel Discord</a>
                </div>
                <div class="flex items-center gap-2">
                  <Icon name="tabler:brand-youtube" class="w-6 h-6 shrink-0" />
                  Preparation:
                  <a class="underline" href="https://youtu.be/htZMgTVczdw" target="_blank" rel="noopener noreferrer">Berlin - Prep Session</a>
                </div>
              </div>
            </div>

            <div class="bg-gradient-primary bg-gray-900 rounded-xl p-4 md:p-8 border border-primary">
              <div class="text-white font-bold text-2xl uppercase tracking-tight mb-6"><span class="text-primary">Deadline:</span> Pitch submission</div>
              <p class="text-lg text-gray-300 font-normal">
                <strong>May 8th 6pm local time:</strong> Code submission <i>(send us the github repo with README explaining the architecture and how to run)</i>
                <br><br> 
                <strong>May 8th 7pm local time:</strong> PPT, video and other material for the pitch <a class="underline text-primary hover:text-white" href="mailto:events@decode.travel">(send via email)</a>.
              </p>
            </div>

        </div>
    </div>
  </section>

  <ChallengeLinks />
  
  <section class="py-8 md:py-16 xl:py-24" id="tech-partner">
      <div class="container relative">
          <div class="font-bold uppercase text-sm mb-4 bg-primary inline-block text-gray-950 px-3 py-2">
              //Camino Network
          </div>
          <div class="font-bold uppercase text-2xl md:text-3xl lg:text-5xl tracking-tight max-w-prose">
              Infrastructure for <br> next-gen dApps
          </div>
          <p class="lg:text-lg text-gray-300 font-normal mt-4 max-w-prose">
            <strong>Camino Network is the L1 blockchain developed for the travel industry.</strong> Camino Network unites businesses, developers, and travelers to make the industry more efficient. Blockchain keeps the ecosystem safe, fair, and fast.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="border border-white/20 bg-gray-900/70 backdrop-blur-3xl rounded-xl mt-5 p-4 lg:p-8">
              <div class="font-bold uppercase text-xl mb-2 lg:mb-4 tracking-tight">EVM-based development:</div>
              <div class="flex items-center gap-2 mb-2 lg:mb-4">
                <Icon name="tabler:file" class="size-6 md:size-8" />
                <div>
                  <div>Access all necessary RPC URLs and API endpoints through the detailed docs:</div>
                  <a class="underline text-primary" href="https://docs.camino.network/guides/metamask-rpc-endpoints" target="_blank" rel="noopener noreferrer">Metamask rpc endpoints</a>
                </div>
              </div>
              <div class="flex items-center gap-2 mb-2 lg:mb-4">
                <Icon name="tabler:brand-github" class="size-6 md:size-8" />
                <div>
                  <div>Explore the Camino Build rep on GitHub:</div>
                  <a class="underline text-primary" href="https://github.com/chain4travel/camino-builder" target="_blank" rel="noopener noreferrer">Camino Builder</a>
                </div>
              </div>
              <div class="flex items-center gap-2 mb-2 lg:mb-4">
                <Icon name="tabler:viewfinder" class="size-6 md:size-8" />
                <div>
                  <div>Use CaminoScan Columbus for real-time blockchain exploration:</div>
                  <a class="underline text-primary" href="https://columbus.caminoscan.com/" target="_blank" rel="noopener noreferrer">Caminoscan.com</a>
                </div>
              </div>
            </div>
          </div>
        <Image class="hidden lg:block absolute -z-10 -right-8 -top-8 w-1/3 xl:w-1/2" src={BugBountyImage} alt="Hexens Abstract Background"/>
      </div>
  </section>

  <section class="py-8 md:py-16">
    <div class="container">
        <Image src={MessengerLogo} class="h-9 w-auto" alt="Messenger Logo" />
        <div class="font-bold uppercase text-4xl md:text-5xl tracking-tighter my-4">
          Travel-to-Web3 Tech Stack
        </div>
        <p class="lg:text-lg text-gray-300 font-normal mb-4 max-w-prose">Camino Messenger is a comprehensive W2W (wallet-to-wallet) communication system for the travel industry with seamless travel data management and exchanges through a unified and encrypted infrastructure based on the Camino Messenger Protocol. Use it to implement search/validate/book funnels on Camino!</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mt-8 relative">
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:↗text-xl/6 tracking-tight">Intro to Messenger:</div>
              <p class="my-3 text-gray-300 text-sm">Get an overview of Camino Messenger, a secure W2W communication solution for travel. Learn how it streamlines data management and exchanges across the industry.</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://chain4travel-my.sharepoint.com/:p:/p/sam_jaarsma/EYxLgIWr1vpJrcoXfXPeBecBwjYeblfqLCetKo6lily6cQ?e=yDHxFS" target="_blank" rel="noopener noreferrer">Read more ↗</a></div>
            </div>
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:↗text-xl/6 tracking-tight">Messenger detailed doc:</div>
              <p class="my-3 text-gray-300 text-sm">Explore detailed documentation for Camino Messenger, guiding you through its encrypted, unified infrastructure for seamless travel communications.</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://docs.camino.network/camino-messenger/introduction" target="_blank" rel="noopener noreferrer">Read more ↗</a></div>
            </div>
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:↗text-xl/6 tracking-tight">Example of a Partner Plugin written in Java Spring Boot / gRPC:</div>
              <p class="my-3 text-gray-300 text-sm">Check out a Java Spring Boot plugin example for easy integration with Camino Messenger. See how to use gRPC for smooth messaging.</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://github.com/chain4travel/camino-messenger-plugin-example-spring-boot" target="_blank" rel="noopener noreferrer">Spring boot example ↗</a></div>
            </div>
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:↗text-xl/6 tracking-tight">Example of a Partner Plugin written in Go: </div>
              <p class="my-3 text-gray-300 text-sm">Explore a Go-based partner plugin for Camino Messenger, offering a hands-on example for integrating wallet-to-wallet communications in your app.</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://github.com/chain4travel/camino-messenger-bot/tree/dev/examples/rpc/partner-plugin" target="_blank" rel="noopener noreferrer">Read more ↗</a></div>
            </div>
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:↗text-xl/6 tracking-tight">Antalya github repo</div>
              <p class="my-3 text-gray-300 text-sm">Visit the Antalya 2024 Resource Hub on GitHub for Camino Messenger tools, guides, and resources for streamlined integration.</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://github.com/DecodeTravel" target="_blank" rel="noopener noreferrer">DecodeTravel Github ↗</a></div>
            </div>
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:↗text-xl/6 tracking-tight">Monerium sandbox</div>
              <p class="my-3 text-gray-300 text-sm">Use this to get your EURe stablecoiins on Columbus and simulate SEPA transfers in and out.</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://sandbox.monerium.dev/" target="_blank" rel="noopener noreferrer">sandbox.monerium.dev ↗</a></div>
            </div>            
        </div>
    </div>
  </section>

  <section class="py-8 md:py-16">
    <div class="container">
        <div class="font-bold uppercase text-4xl md:text-5xl tracking-tighter mb-4">
          The final presentation
        </div>
        <div class="lg:grid grid-cols-2 gap-4 xl:gap-6 2xl:gap-8 mt-8 relative">
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-8 mb-4 md:mb-0">
              <div class="inline-block bg-primary text-gray-950 text-sm font-bold tracking-tighter uppercase py-1 px-2">Requirements</div>
              <div class="my-4 text-white font-bold text-2xl uppercase tracking-tight">Presentation requirements</div>
              <strong>A 10 minute presentation, so keep it short and concise</strong>
              <ul class="list-disc list-inside text-gray-300">
                <li>Problem statement, solution, USP and why is it innovative</li>
                <li>How you leveraged Web3 / Blockchain unique aspects</li>
                <li>How Camino Network, Messenger, other unchain tools was useful</li>
                <li>Brief on architecture and technical feasibility</li>
                <li>Brief on hackathon experience</li>
                <li>Solution to market fit</li>
                <li>Future developments</li>
                <li>Demo (live or video)</li>
              </ul>
              <strong class="mt-8 block">B. Open-source code with README (architecture, how to run), disclose prior work and systems connected</strong>
            </div>
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-8">
              <div class="inline-block bg-primary text-gray-950 text-sm font-bold tracking-tighter uppercase py-1 px-2">Criteria</div>
              <div class="my-4 text-white font-bold text-2xl uppercase tracking-tight">Judging criteria</div>
              <ol class="list-decimal ml-4 text-gray-300">
                <li>Innovative idea, leveraging Web3 / Blockchain unique aspects</li>
                <li>Utilizing Camino, Messenger & other available tech stacks. <strong>Proposing extension to existing functionality is even better.</strong></li>
                <li>Technical feasibility, making use of available APIs </li>
                <li>Market feasibility</li>
                <li>Quality of the presentation & implementation</li>
              </ol>
            </div>
        </div>
    </div>
  </section>

  <section class="py-8 md:py-16">
    <div class="container">
        <div class="font-bold uppercase text-4xl md:text-5xl tracking-tighter my-4">
          Agentic Systems
        </div>
        <p class="lg:text-lg text-gray-300 font-normal mb-4 max-w-prose">Agentic Systems provide a set of tools to help connecting an GenAI-based agent to travel tech systems.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-8 relative">
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:text-2xl tracking-tight">Agentify Platform</div>
              <p class="my-3 text-gray-300">A tool to wrap existing APIs into MCP serve for easy consumption by pipelines or agents</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://github.com/AgenticSystems/decode_bcn_2025" target="_blank" rel="noopener noreferrer">View on Github ↗</a></div>
            </div>
            <div class="bg-gradient-hackerz-b border border-gray-800 bg-gray-900 rounded-xl p-4 md:p-6 flex flex-col">
              <div class="font-bold md:text-2xl tracking-tight">MCP Servers</div>
              <p class="my-3 text-gray-300">Travel product inventory exposed as an MCP servers to fuel your B2C scenarios: tours and activities, flights, info related to weather and place ids...</p>
              <div class="mt-auto"><a class="text-sm py-2 px-3 inline-block rounded-lg font-semibold border-2 border-primary/50 text-primary hover:text-white hover:border-primary transition-colors" href="https://github.com/AgenticSystems/decode_bcn_2025" target="_blank" rel="noopener noreferrer">View on Github ↗</a></div>
            </div>           
        </div>
    </div>
  </section>

  <section class="py-8 md:py-16">
    <div class="container">
        <div class="font-bold uppercase text-4xl md:text-5xl tracking-tighter mb-4">
          Tools
        </div>
        <div class="flex items-center justify-between p-3 hover:rounded-xl border-b border-gray-800 gap-3 md:gap-12 hover:bg-gray-900">
          <strong class="text-xl md:w-32">Miro</strong>
          <div class="text-gray-400 md:w-32">Whiteboard</div>
          <div class="hidden md:block flex-1 text-gray-400 leading-snug">Miro is a visual workspace for innovation where teams manage projects, design products, and build the future together. Join 60M+ users from around the world.</div>
          <a class="text-center bg-primary text-black text-sm font-semibold py-2 px-3 rounded-lg hover:bg-white" href="https://miro.com/app/board/uXjVI5bsSUA=/">Go to tool</a>
        </div>
        <div class="flex items-center justify-between p-3 hover:rounded-xl border-b border-gray-800 gap-3 md:gap-12 hover:bg-gray-900">
          <strong class="text-xl md:w-32">Slidesgo</strong>
          <div class="text-gray-400 md:w-32">PPT Templates</div>
          <div class="hidden md:block flex-1 text-gray-400 leading-snug">Discover the best Google Slides themes and PowerPoint templates you can use in your presentations - 100% Free for any use.</div>
          <a class="text-center bg-primary text-black text-sm font-semibold py-2 px-3 rounded-lg hover:bg-white" href="https://slidesgo.com/">Go to tool</a>
        </div>
        <div class="flex items-center justify-between p-3 hover:rounded-xl border-b border-gray-800 gap-3 md:gap-12 hover:bg-gray-900">
          <strong class="text-xl md:w-32">You Exec</strong>
          <div class="text-gray-400 md:w-32">PPT Templates</div>
          <div class="hidden md:block flex-1 text-gray-400 leading-snug">Business templates done right, download 500+ business presentations, spreadsheet models, and business book summaries.</div>
          <a class="text-center bg-primary text-black text-sm font-semibold py-2 px-3 rounded-lg hover:bg-white" href="https://youexec.com/">Go to tool</a>
        </div>
        <div class="flex items-center justify-between p-3 hover:rounded-xl border-b border-gray-800 gap-3 md:gap-12 hover:bg-gray-900">
          <strong class="text-xl md:w-32">Pixabay</strong>
          <div class="text-gray-400 md:w-32">Stock images</div>
          <div class="hidden md:block flex-1 text-gray-400 leading-snug">Over 4.4 million+ high quality stock images, videos and music shared by our talented community.</div>
          <a class="text-center bg-primary text-black text-sm font-semibold py-2 px-3 rounded-lg hover:bg-white" href="https://youexec.com/">Go to tool</a>
        </div>
        <div class="flex items-center justify-between p-3 hover:rounded-xl border-b border-gray-800 gap-3 md:gap-12 hover:bg-gray-900">
          <strong class="text-xl md:w-32">Pexels</strong>
          <div class="text-gray-400 md:w-32">Stock images</div>
          <div class="hidden md:block flex-1 text-gray-400 leading-snug">The best free stock photos, royalty free images & videos shared by creators.</div>
          <a class="text-center bg-primary text-black text-sm font-semibold py-2 px-3 rounded-lg hover:bg-white" href="https://pexels.com/">Go to tool</a>
        </div>
    </div>
  </section>

</BaseLayout>