---
// NewChallenges.astro - Accordion-style challenges component
import { Image } from 'astro:assets';
import VuelingLogo from '../images/vueling-logo.png';
---

<section class="py-8 md:py-16 xl:py-24" id="new-challenges">
    <div class="container">
        <div class="mb-8">
            <div class="font-bold uppercase mb-4 bg-primary inline-block text-gray-950 px-3 py-2">
                //New Challenges
            </div>
            <div class="font-bold uppercase text-4xl md:text-5xl lg:text-7xl tracking-tighter mb-4">
                Innovation <br> Challenges 2025
            </div>
            <p class="lg:text-xl text-gray-300 max-w-3xl">
                Dive deep into cutting-edge challenges that push the boundaries of travel technology and web3 innovation.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 ">
            <!-- Challenge 1: Blockchain-based turnaround checklist (Vueling) -->
            <div class="vueling-challenge border rounded-xl overflow-hidden p-6">
                <div class="flex gap-4 flex-col">
                    <div class="shrink-0"><Image src={VuelingLogo} alt="Vueling" class="h-6 md:h-8 w-auto" /></div>
                    <h3 class="font-bold md:text-lg uppercase text-vueling">Blockchain-based turnaround checklist</h3>
                </div>
            </div>

            <!-- Challenge 2: Automated supplier payments and real-time fuel settlement (Vueling) -->
            <div class="vueling-challenge border rounded-xl overflow-hidden p-6">
                <div class="flex gap-4 flex-col">
                    <div class="shrink-0"><Image src={VuelingLogo} alt="Vueling" class="h-6 md:h-8 w-auto" /></div>
                    <h3 class="font-bold md:text-lg uppercase text-vueling">Automated supplier payments and real-time fuel settlement</h3>
                </div>
            </div>

            <!-- Challenge 5: Blockchain channel manager -->
            <div class="challenge-item border border-gray-700 rounded-xl overflow-hidden transition-all duration-300">
                <button class="challenge-header w-full text-left p-6 flex items-center justify-between ">
                    <div>
                        <h3 class="font-bold text-xl uppercase mb-2 text-primary">⛓️ Blockchain-powered channel manager reconciliation</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Build a decentralized application leveraging blockchain for automating settlement and reconciliation between hotels and tour operators/OTAs. 
                            Provide fraud-resistant handling with traceable, tamper-proof reporting.
                        </p>
                    </div>
                    <div class="challenge-icon ml-4 flex-shrink-0">
                        <svg class="w-6 h-6 text-primary transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </div>
                </button>
                <div class="challenge-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <div class="p-6 pt-0 border-t border-gray-800/50">
                        <div class="text-gray-300 space-y-4">
                            <p>
                                The system should provide fraud-resistant handling of bookings, cancellations, and importantly, modifications (as additional blockchain transactions). 
                                The dApp must ensure traceable, tamper-proof reporting, minimizing manual reconciliation efforts. Facilitate transparent reconciliation with 
                                guaranteed audit trails accessible to all stakeholders.
                            </p>
                            <p>
                                Since bookings on chain are immutable, handle modifications as additional transactions that update the booking state. Use "stacked NFTs" or 
                                linked tokens to represent modifications and the current state of the booking. Propose a Camino Messenger Format for Modification.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Challenge 6: AI-powered personalized upselling -->
            <div class="challenge-item border border-gray-700 rounded-xl overflow-hidden transition-all duration-300">
                <button class="challenge-header w-full text-left p-6 flex items-center justify-between ">
                    <div>
                        <h3 class="font-bold text-xl uppercase mb-2 text-primary">💎 AI-powered personalized upselling for wallet-linked hotel guests</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Build a solution for hotels that intelligently proposes personalized upsell offers matching guest preferences and profiles. 
                            Use AI-driven insights combined with CRM data to ensure timely, valuable, and welcome offers.
                        </p>
                    </div>
                    <div class="challenge-icon ml-4 flex-shrink-0">
                        <svg class="w-6 h-6 text-primary transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </div>
                </button>
                <div class="challenge-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <div class="p-6 pt-0 border-t border-gray-800/50">
                        <div class="text-gray-300 space-y-4">
                            <p>
                                Upon receiving a confirmed booking with a known end-consumer's digital wallet address, the system should intelligently propose 
                                personalized upsell offers that match the guest's preferences and profile, avoiding irrelevant or annoying push offers.
                            </p>
                            <p>
                                Use the blockchain wallet address associated with the guest to securely create/link to their historical CRM or loyalty profile data 
                                (preferences, past stays, spend patterns). Use AI to analyse (mocked) CRM data, past booking context, and guest behaviour to generate 
                                upsell offers (room upgrades, dining, spa, experiences) with high relevance and likelihood of acceptance.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Challenge 9: Intelligent travel itinerary booking -->
            <div class="challenge-item border border-gray-700 rounded-xl overflow-hidden transition-all duration-300">
                <button class="challenge-header w-full text-left p-6 flex items-center justify-between ">
                    <div>
                        <h3 class="font-bold text-xl uppercase mb-2 text-primary">🧠 Intelligent travel itinerary booking platform</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Develop a system where travel agents, AI agents, or authorized parties can intelligently compose and book travel services across multiple suppliers. 
                            Function as an intelligent intermediary that aggregates capabilities and routes requests based on preferences and business rules.
                        </p>
                    </div>
                    <div class="challenge-icon ml-4 flex-shrink-0">
                        <svg class="w-6 h-6 text-primary transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </div>
                </button>
                <div class="challenge-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <div class="p-6 pt-0 border-t border-gray-800/50">
                        <div class="text-gray-300 space-y-4">
                            <p>
                                Create logic to analyse booking requests and intelligently match them with suitable travel suppliers based on destination, service type, 
                                price range, and quality metrics. Implement a supplier discovery mechanism that maintains an updated catalogue of available services and their capabilities.
                            </p>
                            <p>
                                Enable instant payments using on-chain currency USDC or Monerium's EURe currency through blockchain infrastructure. The system should optimize 
                                for both speed and cost-effectiveness while maintaining transparency in supplier selection and pricing.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Challenge: Taming Overtourism -->
            <div class="challenge-item border border-gray-700 rounded-xl overflow-hidden transition-all duration-300">
                <button class="challenge-header w-full text-left p-6 flex items-center justify-between ">
                    <div>
                        <h3 class="font-bold text-xl uppercase mb-2 text-primary">🌍 Taming Overtourism – Smarter Travel, Fairer Footprints</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Overtourism threatens the long-term health of global travel. This challenge explores how open, data-driven technology can make tourism distribution more balanced, responsive, and fair.
                        </p>
                    </div>
                    <div class="challenge-icon ml-4 flex-shrink-0">
                        <svg class="w-6 h-6 text-primary transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </div>
                </button>
                <div class="challenge-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <div class="p-6 pt-0 border-t border-gray-800/50">
                        <div class="text-gray-300 space-y-4">
                            <p>
                                Your goal is to design a solution that combines blockchain, digital identity, and data intelligence to:
                            </p>
                            <ul class="list-disc list-inside space-y-2 ml-4">
                                <li>Encourage travelers to discover lesser-visited places and experiences.</li>
                                <li>Offer rewards for visiting hotspots during off-peak hours or days to ease congestion and enhance traveler experience.</li>
                                <li>Reward responsible, low-impact travel behaviors across all travel areas.</li>
                                <li>Provide real-time insight into how busy an attraction is using Bluetooth or NFC-based tags for live crowd data.</li>
                                <li>Enable fair and transparent value sharing across the local travel ecosystem.</li>
                            </ul>
                            <p class="font-bold mt-6">Possible Tracks:</p>
                            <ul class="list-disc list-inside space-y-3 ml-4">
                                <li>
                                    <strong>AI Agents for Travel Flow:</strong> Build a digital assistant that helps travelers plan smarter. Suggest trips to hidden gems or recommend visiting hotspots during off-peak times based on crowd patterns, weather, and local events.
                                </li>
                                <li>
                                    <strong>Tokenized Sustainability and Timing Rewards:</strong> Create a system that issues rewards for sustainable travel or verified visits during quieter hours or days. Proof-of-visit could use Bluetooth or NFC tags that also feed real-time crowd insights back into the network.
                                </li>
                                <li>
                                    <strong>Dynamic Travel Insights via Camino Messenger:</strong> Use Camino's decentralized messaging network to exchange real-time availability, congestion, and sustainability data between travel areas and local operators.
                                </li>
                            </ul>
                            <p class="font-bold mt-6">Why It Matters:</p>
                            <p>
                                Overtourism isn't just an environmental issue — it's a visibility and data imbalance. With transparent, decentralized tools, we can make travel more evenly distributed, more rewarding, and better for everyone involved.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    // Accordion functionality
    document.addEventListener('DOMContentLoaded', function() {
        const challengeItems = document.querySelectorAll('.challenge-item');
        
        challengeItems.forEach(item => {
            const header = item.querySelector('.challenge-header') as HTMLElement;
            const content = item.querySelector('.challenge-content') as HTMLElement;
            const icon = item.querySelector('.challenge-icon svg') as HTMLElement;
            
            if (header && content && icon) {
                header.addEventListener('click', () => {
                    const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
                    
                // Close all other items
                challengeItems.forEach(otherItem => {
                    if (otherItem !== item) {
                        const otherContent = otherItem.querySelector('.challenge-content') as HTMLElement;
                        if (otherContent) {
                            otherContent.style.maxHeight = '0px';
                            otherItem.classList.remove('open');
                        }
                    }
                });
                
                // Toggle current item
                if (isOpen) {
                    content.style.maxHeight = '0px';
                    item.classList.remove('open');
                } else {
                    content.style.maxHeight = content.scrollHeight + 'px';
                    item.classList.add('open');
                }
                });
            }
        });
    });
</script>

<style>
    .challenge-content {
        transition: max-height 0.3s ease-in-out;
    }
    
    /* Open state effects */
    .challenge-item.open {
        border-color: #00F3B1;
        box-shadow: 0 10px 15px -3px rgba(0, 243, 177, 0.1), 0 4px 6px -2px rgba(0, 243, 177, 0.05);
    }
    
    .challenge-item.open .challenge-icon svg {
        color: #00F3B1;
        transform: rotate(180deg);
    }
    
    .challenge-item.open h3 {
        color: #00F3B1;
    }
    
    /* Mobile optimizations */
    @media (max-width: 768px) {
        .challenge-header {
            padding: 1rem;
        }
        
        .challenge-header h3 {
            font-size: 1rem;
            line-height: 1.3;
        }
        
        .challenge-header p {
            font-size: 0.875rem;
            margin-top: 0.5rem;
        }
        
        .challenge-content .p-6 {
            padding: 1rem;
        }
    }
    
    /* Tablet optimizations */
    @media (min-width: 769px) and (max-width: 1023px) {
        .challenge-header h3 {
            font-size: 1.1rem;
        }
    }
    
    /* Large screen optimizations */
    @media (min-width: 1024px) {
        .challenge-item {
            min-height: 200px;
        }
    }
    
    /* Vueling challenge highlighting */
    .vueling-challenge {
        background: linear-gradient(135deg, rgba(249, 199, 0, 0.08) 0%, rgba(249, 199, 0, 0.02) 100%);
        border-color: #f9c700 !important;
        box-shadow: 0 4px 6px -1px rgba(249, 199, 0, 0.1), 0 2px 4px -1px rgba(249, 199, 0, 0.06);
    }
    
    .text-vueling {
        color: #f9c700;
    }
</style>
