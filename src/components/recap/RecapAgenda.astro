---
import type { AgendaDay } from '../../data/types';
import SectionTitle from './SectionTitle.astro';
interface Props { days: AgendaDay[]; title: string; }
const { days, title } = Astro.props;
const cols = days.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---
<section class="py-8 md:py-16" id="agenda">
    <div class="container">
        <SectionTitle label="Agenda" title={title} />
        <div class={`grid grid-cols-1 sm:grid-cols-2 ${cols} gap-3 sm:gap-4 lg:gap-6 mt-8 relative`}>
            <div class="w-full h-2 hidden lg:block bg-gradient-to-r from-gray-900 via-primary to-gray-900 absolute z-0 top-1/2 -translate-y-1"></div>
            {days.map((d) => (
                <div class="bg-gradient-primary border border-gray-700 bg-gray-900 rounded-xl p-4 md:p-6 z-10">
                    <div class="uppercase font-bold text-lg font-mono md:text-xl mb-2 text-primary">// {d.day}</div>
                    <div class="text-gray-300 mb-2 italic text-lg">{d.date}</div>
                    <div class="uppercase font-bold text-lg md:text-xl mb-2">{d.title}</div>
                    <ul class="space-y-1">
                        {d.items.map((i) => (
                            <li>{i.time && <strong class="mr-2 font-mono font-medium">{i.time}</strong>}{i.text}</li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>
