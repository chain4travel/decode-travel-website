---
import type { Edition } from '../../data/types';
import SourcedP from './SourcedP.astro';
interface Props { edition: Edition; }
const { edition } = Astro.props;
---
<section class="py-10 md:py-16" id="numbers">
    <div class="container">
        <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-start">
            <div class="lg:col-span-3 space-y-5 text-lg text-gray-200">
                {edition.intro.map((p) => <SourcedP item={p} />)}
            </div>
            {edition.stats.length > 0 && (
                <div class="lg:col-span-2">
                    <div class="font-bold uppercase mb-4 bg-primary inline-block text-gray-950 px-3 py-2">//In numbers</div>
                    <dl class="grid grid-cols-2 gap-3">
                        {edition.stats.map((s) => (
                            <div class="bg-gradient-primary border border-gray-700 bg-gray-900 rounded-xl p-4">
                                <dt class="sr-only">{s.label}</dt>
                                <dd>
                                    <div class="text-3xl md:text-4xl font-bold text-primary tracking-tight">{s.value}</div>
                                    <div class="text-gray-300 text-sm mt-1">{s.label}</div>
                                </dd>
                            </div>
                        ))}
                    </dl>
                </div>
            )}
        </div>
    </div>
</section>
